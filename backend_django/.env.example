# 本地开发配置示例。复制为 .env 后填写真实密码；.env 已被 gitignore。
# 也可以不使用 .env，直接通过系统环境变量提供这些值。
DB_NAME=poetry_db
DB_USER=root
DB_PASSWORD=CHANGE_ME
DB_HOST=127.0.0.1
DB_PORT=3306
DB_TEST_NAME=poetry_db_test

DJANGO_SECRET_KEY=change-me-to-a-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
SQL_DEBUG=0
