<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.poetry.mapper.GenreMapper">

    <select id="listGenres" resultType="com.poetry.entity.Genre">
        SELECT genre_id, name, description
        FROM genre
        ORDER BY genre_id
    </select>

    <!-- 流派名称的 UNIQUE 约束在数据库端防重 -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="genreId">
        INSERT INTO genre (name, description)
        VALUES (#{name}, #{description})
    </insert>

    <update id="update">
        UPDATE genre
        SET name = #{name}, description = #{description}
        WHERE genre_id = #{genreId}
    </update>

    <!-- 删除流派: poem_genre 收录关系经外键级联清除 -->
    <delete id="deleteById">
        DELETE FROM genre WHERE genre_id = #{genreId}
    </delete>
</mapper>
