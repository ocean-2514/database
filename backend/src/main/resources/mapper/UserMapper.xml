<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.poetry.mapper.UserMapper">

    <sql id="userColumns">
        user_id, username, password_hash, email, role, status, register_time
    </sql>

    <select id="findByUsername" resultType="com.poetry.entity.User">
        SELECT <include refid="userColumns"/>
        FROM `user`
        WHERE username = #{username}
    </select>

    <select id="findByUserId" resultType="com.poetry.entity.User">
        SELECT <include refid="userColumns"/>
        FROM `user`
        WHERE user_id = #{userId}
    </select>

    <!-- 注册: 调用存储过程 sp_register_user (过程内部做用户名查重 + 插入)。
         第 4 个参数 mode=OUT: 过程把 LAST_INSERT_ID 写回, MyBatis 再把它
         设置到 RegisterParam.userId 属性上 -->
    <insert id="register" statementType="CALLABLE">
        {CALL sp_register_user(
            #{username,     mode=IN,  jdbcType=VARCHAR},
            #{passwordHash, mode=IN,  jdbcType=VARCHAR},
            #{email,        mode=IN,  jdbcType=VARCHAR},
            #{userId,       mode=OUT, jdbcType=BIGINT})}
    </insert>
</mapper>
