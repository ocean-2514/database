<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.poetry.mapper.CommentMapper">

    <sql id="commentColumns">
        comment_id, user_id, poem_id, content, comment_time, like_count
    </sql>

    <select id="findByCommentId" resultType="com.poetry.entity.Comment">
        SELECT <include refid="commentColumns"/>
        FROM `comment`
        WHERE comment_id = #{commentId}
    </select>

    <!-- 某诗的评论(当前页): JOIN 用户取用户名; 索引 idx_comment_poem_time 支撑排序 -->
    <select id="listByPoem" resultType="com.poetry.entity.CommentItem">
        SELECT c.comment_id,
               u.username,
               c.content,
               c.like_count,
               c.comment_time
        FROM `comment` c
        JOIN `user` u ON u.user_id = c.user_id
        WHERE c.poem_id = #{poemId}
        ORDER BY c.comment_time DESC
        LIMIT #{offset}, #{pageSize}
    </select>

    <select id="countByPoem" resultType="long">
        SELECT COUNT(*)
        FROM `comment`
        WHERE poem_id = #{poemId}
    </select>

    <!-- useGeneratedKeys: 插入后 MySQL 的自增 comment_id 回填到参数对象 -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="commentId">
        INSERT INTO `comment` (user_id, poem_id, content)
        VALUES (#{userId}, #{poemId}, #{content})
    </insert>

    <update id="updateContent">
        UPDATE `comment`
        SET content = #{content}
        WHERE comment_id = #{commentId}
    </update>

    <delete id="deleteComment">
        DELETE FROM `comment`
        WHERE comment_id = #{commentId}
    </delete>
</mapper>
